#!/usr/bin/env bash
set -euo pipefail

VERSION="2.0.0-restic"
INSTALL_DIR="$HOME/.backbot"
CONFIG_DIR="$HOME/.config/backbot"
CONFIG_FILE="$CONFIG_DIR/restic.conf"
EXCLUDE_FILE="$CONFIG_DIR/exclude.list"
LOG_DIR="$HOME/.local/share/backbot/logs"

KEYCHAIN_SERVICE="backbot-restic"
KEYCHAIN_ACCOUNT="backbot"

mkdir -p "$LOG_DIR"

[[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

: "${RESTIC_REPOSITORY:=}"
: "${RESTIC_PASSWORD_COMMAND:=security find-generic-password -s $KEYCHAIN_SERVICE -a $KEYCHAIN_ACCOUNT -w}"
: "${BACKUP_SOURCE:=$HOME}"
: "${STORAGE_CLASS:=GLACIER_IR}"
: "${KEEP_LAST:=3}"
: "${KEEP_DAILY:=7}"
: "${KEEP_WEEKLY:=4}"
: "${KEEP_MONTHLY:=12}"
: "${NOTIFY:=terminal-notifier}"
: "${PRUNE_DAY:=7}"
: "${LOG_RETENTION_DAYS:=90}"

export RESTIC_REPOSITORY RESTIC_PASSWORD_COMMAND
# Honor a dedicated AWS profile if the user configured one
[[ -n "${AWS_PROFILE:-}" ]] && export AWS_PROFILE

die() { echo "ERROR: $*" >&2; exit 1; }

notify() {
    local title="$1"; local msg="$2"
    if [[ "$NOTIFY" == "terminal-notifier" ]] && command -v terminal-notifier >/dev/null 2>&1; then
        terminal-notifier -title "$title" -message "$msg" -sender com.apple.Terminal >/dev/null 2>&1 || true
    fi
}

require_repo() {
    [[ -n "${RESTIC_REPOSITORY:-}" ]] || die "No repository configured. Run 'backbot configure' first."
}

cmd_backup() {
    require_repo
    local ts; ts=$(date +%Y%m%d-%H%M%S)
    local log="$LOG_DIR/backup-$ts.log"
    echo "Logging to $log"
    {
        echo "=== backbot backup $ts ==="
        echo "source: $BACKUP_SOURCE"
        echo "repo:   $RESTIC_REPOSITORY"
        echo "class:  $STORAGE_CLASS"
        echo

        # Capture restic's exit code without letting `set -e` abort on it.
        # restic returns 3 when some source files were unreadable (e.g. iCloud
        # bundles with "resource deadlock avoided") — that's a successful backup.
        local rc=0
        restic backup "$BACKUP_SOURCE" \
            --exclude-file="$EXCLUDE_FILE" \
            --exclude-caches \
            --tag nightly \
            -o s3.storage-class="$STORAGE_CLASS" 2>&1 || rc=$?

        # restic exit codes: 0=clean, 3=completed with read warnings, other=failure
        if [[ $rc -eq 0 || $rc -eq 3 ]]; then
            local forget_args=(--keep-last "$KEEP_LAST" --keep-daily "$KEEP_DAILY" --keep-weekly "$KEEP_WEEKLY" --keep-monthly "$KEEP_MONTHLY")

            echo
            local frc=0
            if [[ "$(date +%u)" == "$PRUNE_DAY" ]]; then
                echo "=== weekly forget + prune ==="
                restic forget "${forget_args[@]}" --prune -o s3.storage-class="$STORAGE_CLASS" 2>&1 || frc=$?
            else
                echo "=== forget (no prune today) ==="
                restic forget "${forget_args[@]}" 2>&1 || frc=$?
            fi
            [[ $frc -ne 0 ]] && echo "WARN: retention (forget) exited $frc — backup itself was fine"

            if [[ $rc -eq 3 ]]; then
                notify "Backbot" "Backup complete (some files unreadable — see log)"
                echo
                echo "DONE (with read warnings — exit 3)"
            else
                notify "Backbot" "Backup complete"
                echo
                echo "DONE"
            fi
        else
            notify "Backbot" "Backup FAILED (exit $rc) — check $log"
            echo "FAILED (exit $rc)"
            exit 1
        fi
    } 2>&1 | tee -a "$log"

    find "$LOG_DIR" -name "backup-*.log" -mtime "+$LOG_RETENTION_DAYS" -delete 2>/dev/null || true
}

# Interactive setup: AWS credentials, S3 bucket, repo password, restic init.
# Safe to re-run — only changes what you confirm.
cmd_configure() {
    mkdir -p "$CONFIG_DIR"
    echo "=== backbot configure ==="
    echo
    echo "This stores your own AWS keys and points backbot at your S3 bucket."
    echo "AWS keys are saved to a dedicated 'backbot' AWS CLI profile (~/.aws),"
    echo "never to this repo or the backup itself."
    echo

    command -v aws >/dev/null 2>&1 || die "AWS CLI not found. Install it: brew install awscli"
    command -v restic >/dev/null 2>&1 || die "restic not found. Install it: brew install restic"

    local profile="${AWS_PROFILE:-backbot}"

    # ── AWS credentials ────────────────────────────────────────────────
    local have_keys="no"
    if aws configure get aws_access_key_id --profile "$profile" >/dev/null 2>&1; then
        have_keys="yes"
        echo "AWS profile '$profile' already has keys."
        read -rp "Replace them? [y/N] " a
        [[ "${a:-N}" =~ ^[Yy]$ ]] && have_keys="no"
    fi

    if [[ "$have_keys" == "no" ]]; then
        local key secret region
        read -rp "AWS Access Key ID: " key
        [[ -n "$key" ]] || die "Access Key ID required."
        read -rsp "AWS Secret Access Key: " secret; echo
        [[ -n "$secret" ]] || die "Secret Access Key required."
        read -rp "AWS region [us-west-1]: " region; region="${region:-us-west-1}"

        aws configure set aws_access_key_id     "$key"    --profile "$profile"
        aws configure set aws_secret_access_key  "$secret" --profile "$profile"
        aws configure set region                 "$region" --profile "$profile"
        echo "Saved to AWS profile '$profile'."
    fi

    local region; region="$(aws configure get region --profile "$profile" 2>/dev/null || echo us-west-1)"
    echo

    # ── S3 bucket ──────────────────────────────────────────────────────
    local bucket
    read -rp "S3 bucket name for backups: " bucket
    [[ -n "$bucket" ]] || die "Bucket name required."

    if AWS_PROFILE="$profile" aws s3 ls "s3://$bucket" >/dev/null 2>&1; then
        echo "Bucket accessible: s3://$bucket"
    else
        echo "Bucket s3://$bucket not accessible (may not exist yet)."
        read -rp "Create it in $region now? [y/N] " a
        if [[ "${a:-N}" =~ ^[Yy]$ ]]; then
            if [[ "$region" == "us-east-1" ]]; then
                AWS_PROFILE="$profile" aws s3api create-bucket --bucket "$bucket" --region "$region"
            else
                AWS_PROFILE="$profile" aws s3api create-bucket --bucket "$bucket" --region "$region" \
                    --create-bucket-configuration LocationConstraint="$region"
            fi
            echo "Created s3://$bucket"
        fi
    fi

    local repo="s3:s3.${region}.amazonaws.com/${bucket}"
    echo

    # ── restic repo password (macOS Keychain) ──────────────────────────
    if security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$KEYCHAIN_ACCOUNT" -w >/dev/null 2>&1; then
        echo "Repo password already in Keychain (service: $KEYCHAIN_SERVICE)."
    else
        echo "Generating restic repository password (stored in macOS Keychain)..."
        local pw; pw="$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 48)"
        security add-generic-password -s "$KEYCHAIN_SERVICE" -a "$KEYCHAIN_ACCOUNT" -w "$pw" -U -T "" 2>/dev/null || true
        echo "Stored. BACK THIS UP — without it your data is unrecoverable:"
        echo "  security find-generic-password -s $KEYCHAIN_SERVICE -a $KEYCHAIN_ACCOUNT -w"
    fi
    echo

    # ── Storage class ──────────────────────────────────────────────────
    local sclass
    read -rp "Storage class [GLACIER_IR]: " sclass; sclass="${sclass:-GLACIER_IR}"

    # ── Write config ───────────────────────────────────────────────────
    cat > "$CONFIG_FILE" <<EOF
# backbot config — generated by 'backbot configure'
RESTIC_REPOSITORY="$repo"
RESTIC_PASSWORD_COMMAND="security find-generic-password -s $KEYCHAIN_SERVICE -a $KEYCHAIN_ACCOUNT -w"
AWS_PROFILE="$profile"
BACKUP_SOURCE="\$HOME"
STORAGE_CLASS="$sclass"
KEEP_LAST=3
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=12
NOTIFY="terminal-notifier"
PRUNE_DAY=7
LOG_RETENTION_DAYS=90
EOF
    echo "Wrote $CONFIG_FILE"
    echo

    # ── Initialize repo ────────────────────────────────────────────────
    export RESTIC_REPOSITORY="$repo"
    export RESTIC_PASSWORD_COMMAND="security find-generic-password -s $KEYCHAIN_SERVICE -a $KEYCHAIN_ACCOUNT -w"
    export AWS_PROFILE="$profile"
    if restic cat config >/dev/null 2>&1; then
        echo "restic repo already initialized."
    else
        read -rp "Initialize restic repo at $repo now? [Y/n] " a
        if [[ "${a:-Y}" =~ ^[Yy]?$ ]]; then
            restic init -o s3.storage-class="$sclass"
            echo "Repo initialized."
        fi
    fi
    echo
    echo "Done. Run your first backup with:  backbot backup"
}

cmd_status() {
    echo "=== backbot status ==="
    echo "Version: $VERSION"
    echo "Repo:    ${RESTIC_REPOSITORY:-(not configured — run 'backbot configure')}"
    echo "Source:  $BACKUP_SOURCE"
    echo "Class:   $STORAGE_CLASS"
    echo "Profile: ${AWS_PROFILE:-(default)}"
    echo
    echo "--- Latest snapshot ---"
    restic snapshots --latest 1 2>&1 | tail -10 || true
    echo
    echo "--- Repo stats ---"
    restic stats latest 2>&1 || echo "(no snapshots yet)"
    echo
    echo "--- Launchd ---"
    launchctl list | grep backbot || echo "(not loaded)"
    echo
    echo "--- Recent logs ---"
    ls -lt "$LOG_DIR"/*.log 2>/dev/null | head -5 || true
}

cmd_uninstall() {
    echo "Removes the launchd job, wrapper, and config dirs."
    echo "S3 bucket data and Keychain passphrase are NOT touched."
    read -rp "Continue? [y/N] " a
    [[ "${a:-N}" =~ ^[Yy]$ ]] || exit 0
    launchctl bootout "gui/$(id -u)/com.backbot.nightly" 2>/dev/null || true
    rm -f "$HOME/Library/LaunchAgents/com.backbot.nightly.plist"
    rm -f "$HOME/.local/bin/backbot"
    rm -rf "$INSTALL_DIR"
    echo "Done."
    echo "  S3 data: aws s3 rb s3://<bucket> --force"
    echo "  Keychain: security delete-generic-password -s $KEYCHAIN_SERVICE -a $KEYCHAIN_ACCOUNT"
}

cmd_help() {
    cat <<EOF
backbot $VERSION

Commands:
  configure                  Set up AWS keys, S3 bucket, repo password, init repo
  backup                     Run backup + retention forget (+prune on Sundays)
  snapshots [opts]           List snapshots
  ls <snap-id> [path]        List files in a snapshot
  restore <snap-id> ...      Restore (e.g. --target /tmp/r --include /Users/...)
  mount <dir>                FUSE-mount the repo (browse like a filesystem)
  diff <snap-a> <snap-b>     Diff two snapshots
  check                      Verify repo integrity
  forget [opts]              Manual retention (raw restic forget)
  prune                      Manual prune
  stats                      Repo size stats
  status                     Show config, latest snapshot, launchd state
  uninstall                  Remove wrapper + launchd job
  version                    Show version
  help                       Show this

Config:   $CONFIG_FILE
Excludes: $EXCLUDE_FILE
Logs:     $LOG_DIR

Pass-through subcommands forward args directly to restic.
EOF
}

cmd_version() { echo "backbot $VERSION"; }

case "${1:-help}" in
    configure|setup)     shift; cmd_configure "$@" ;;
    backup)              shift; cmd_backup "$@" ;;
    snapshots)           shift; restic snapshots "$@" ;;
    ls)                  shift; restic ls "$@" ;;
    restore)             shift; restic restore "$@" ;;
    mount)               shift; restic mount "$@" ;;
    diff)                shift; restic diff "$@" ;;
    check)               shift; restic check "$@" ;;
    forget)              shift; restic forget "$@" ;;
    prune)               shift; restic prune -o s3.storage-class="$STORAGE_CLASS" "$@" ;;
    stats)               shift; restic stats "$@" ;;
    status)              cmd_status ;;
    uninstall)           cmd_uninstall ;;
    help|-h|--help)      cmd_help ;;
    version|-v|--version) cmd_version ;;
    *) echo "Unknown command: $1" >&2; cmd_help; exit 1 ;;
esac
