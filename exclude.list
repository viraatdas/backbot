# backbot exclude list (restic format)
# - Names without "/" match anywhere in the tree (e.g. node_modules)
# - Patterns starting with "/" anchor at filesystem root
# - Glob: * matches within a path component, ** matches across

# === Version control & build artifacts (any depth) ===
.git
node_modules
__pycache__
build
dist
.next
.nuxt
.turbo
target
.gradle
Pods
.eggs
*.egg-info

# === macOS junk ===
.DS_Store
.Spotlight-V100
.fseventsd
.TemporaryItems
.Trashes

# === macOS protected/system metadata (no process can read these — even with FDA) ===
Library/Metadata/CoreSpotlight
Library/Application Support/FileProvider

# === Top-of-$HOME reproducible / phantom dirs ===
__HOME__/.Trash
__HOME__/conductor
__HOME__/OrbStack
__HOME__/.orbstack

# === Language / package-manager caches (any location) ===
.cache
.npm
.bun
.yarn/cache
.pnpm-store
.cargo/registry
.cargo/git
.rustup
.gradle/caches
.cocoapods
.gem
.cpan
.m2/repository
.electron-gyp
.expo
.cdk
.fastlane
.ghcup
.cabal
.stack
.superset
.EasyOCR

# === Python virtualenvs ===
.venv
venv
.tox
.mypy_cache
.pytest_cache
.ruff_cache

# === Docker / container state ===
.docker/buildx

# === macOS Library — reproducible / synced-elsewhere subtrees ===
Library/Caches
Library/Logs
Library/Developer
Library/Application Support/MobileSync
Library/Application Support/Steam/steamapps
Library/Application Support/Steam/SteamApps
Library/Application Support/Slack
Library/Application Support/discord
Library/Application Support/Code/Cache
Library/Application Support/Code/CachedData
Library/Application Support/Cursor/Cache
Library/Application Support/Cursor/CachedData
Library/Application Support/Google/Chrome
Library/Application Support/Firefox
Library/Application Support/BraveSoftware
Library/Application Support/Spotify
Library/Application Support/Docker Desktop
Library/Group Containers
Library/Containers
Library/pnpm
Library/Photos
Library/Daemon Containers
Library/IntelligencePlatform
Library/DuetExpertCenter
Library/Biome

# === Virtual machine images ===
*.vmdk
*.vdi
*.qcow2
*.raw
VirtualBox VMs

# === Temp files ===
*.tmp
*.swp
*.swo
tmp
